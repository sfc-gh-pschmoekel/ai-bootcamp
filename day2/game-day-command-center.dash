{
  "version": 2,
  "title": "Game Day Command Center",
  "datasources": {
    "ds-kpis": {
      "type": "sql",
      "columns": [
        {
          "name": "TOTAL_REVENUE",
          "type": "NUMBER"
        },
        {
          "name": "PER_CAP_SPEND",
          "type": "NUMBER"
        },
        {
          "name": "ATTENDANCE_PCT",
          "type": "NUMBER"
        },
        {
          "name": "DONATIONS_AFTER_GAME",
          "type": "NUMBER"
        },
        {
          "name": "TOTAL_ATTENDANCE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    AGG(total_revenue) AS TOTAL_REVENUE,\n    AGG(per_cap_spend) AS PER_CAP_SPEND,\n    AGG(attendance_pct) AS ATTENDANCE_PCT,\n    AGG(donations_after_game) AS DONATIONS_AFTER_GAME,\n    AGG(total_attendance) AS TOTAL_ATTENDANCE\nFROM SATURDAY_OPS.ANALYTICS.SATURDAY_OPS_SV"
    },
    "ds-games": {
      "type": "sql",
      "columns": [
        {
          "name": "GAME_LABEL",
          "type": "VARCHAR"
        },
        {
          "name": "HOME_WEEK",
          "type": "NUMBER"
        },
        {
          "name": "HOME_OPPONENT",
          "type": "VARCHAR"
        },
        {
          "name": "OPPONENT_STYLE",
          "type": "VARCHAR"
        },
        {
          "name": "HOME_RESULT",
          "type": "VARCHAR"
        },
        {
          "name": "TOTAL_REVENUE",
          "type": "NUMBER"
        },
        {
          "name": "PER_CAP_SPEND",
          "type": "NUMBER"
        },
        {
          "name": "ATTENDANCE_PCT",
          "type": "NUMBER"
        },
        {
          "name": "DONATIONS_AFTER_GAME",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    'Wk ' || HOME_WEEK || ' ' || HOME_OPPONENT AS GAME_LABEL,\n    HOME_WEEK,\n    HOME_OPPONENT,\n    REPLACE(OPPONENT_STYLE, '_', ' ') AS OPPONENT_STYLE,\n    HOME_RESULT,\n    TOTAL_REVENUE,\n    PER_CAP_SPEND,\n    ATTENDANCE_PCT,\n    DONATIONS_AFTER_GAME\nFROM (\n    SELECT\n        home_week,\n        home_opponent,\n        opponent_style,\n        home_result,\n        AGG(total_revenue) AS TOTAL_REVENUE,\n        AGG(per_cap_spend) AS PER_CAP_SPEND,\n        AGG(attendance_pct) AS ATTENDANCE_PCT,\n        AGG(donations_after_game) AS DONATIONS_AFTER_GAME\n    FROM SATURDAY_OPS.ANALYTICS.SATURDAY_OPS_SV\n    GROUP BY\n        home_week,\n        home_opponent,\n        opponent_style,\n        home_result\n)\nORDER BY\n    HOME_WEEK"
    },
    "ds-fan-weeks": {
      "type": "sql",
      "columns": [
        {
          "name": "GAME_LABEL",
          "type": "VARCHAR"
        },
        {
          "name": "HOME_WEEK",
          "type": "NUMBER"
        },
        {
          "name": "AVG_FAN_SENTIMENT",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    'Wk ' || HOME_WEEK || ' ' || HOME_OPPONENT AS GAME_LABEL,\n    HOME_WEEK,\n    AVG_FAN_SENTIMENT\nFROM (\n    SELECT\n        home_week,\n        home_opponent,\n        AGG(avg_fan_sentiment) AS AVG_FAN_SENTIMENT\n    FROM SATURDAY_OPS.ANALYTICS.SATURDAY_OPS_SV\n    GROUP BY\n        home_week,\n        home_opponent\n)\nORDER BY\n    HOME_WEEK"
    },
    "ds-fan-categories": {
      "type": "sql",
      "columns": [
        {
          "name": "COMPLAINT_CATEGORY",
          "type": "VARCHAR"
        },
        {
          "name": "COMPLAINT_COUNT",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    REPLACE(COMPLAINT_CATEGORY, '_', ' ') AS COMPLAINT_CATEGORY,\n    COMPLAINT_COUNT\nFROM (\n    SELECT\n        complaint_category,\n        AGG(complaint_count) AS COMPLAINT_COUNT\n    FROM SATURDAY_OPS.ANALYTICS.SATURDAY_OPS_SV\n    GROUP BY\n        complaint_category\n)\nORDER BY\n    COMPLAINT_COUNT DESC"
    }
  },
  "layout": {
    "overview": {
      "meta": {
        "default": true
      },
      "positions": {
        "kpi-total-revenue": {
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 2
        },
        "kpi-per-cap": {
          "x": 3,
          "y": 0,
          "w": 3,
          "h": 2
        },
        "kpi-fill-rate": {
          "x": 6,
          "y": 0,
          "w": 3,
          "h": 2
        },
        "kpi-donations": {
          "x": 9,
          "y": 0,
          "w": 3,
          "h": 2
        },
        "revenue-by-game": {
          "x": 0,
          "y": 2,
          "w": 12,
          "h": 4
        },
        "game-scorecard": {
          "x": 0,
          "y": 6,
          "w": 12,
          "h": 4
        }
      }
    },
    "fan": {
      "meta": {},
      "positions": {
        "fan-sentiment": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "tickets-by-category": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 5
        }
      }
    }
  },
  "tabs": [
    {
      "tab_id": "overview",
      "title": "Game Day Overview",
      "tiles": [
        {
          "tile_id": "kpi-total-revenue",
          "type": "chart",
          "title": "Total game-day revenue",
          "datasources": [
            "ds-kpis"
          ],
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "TOTAL_REVENUE",
                  "labelField": "",
                  "format": "currency",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": false,
                  "sparklineEnabled": false,
                  "labelEnabled": false
                }
              }
            }
          }
        },
        {
          "tile_id": "kpi-per-cap",
          "type": "chart",
          "title": "Per cap spend",
          "datasources": [
            "ds-kpis"
          ],
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "PER_CAP_SPEND",
                  "labelField": "",
                  "format": "currency",
                  "decimals": 2,
                  "abbreviate": false,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": false,
                  "sparklineEnabled": false,
                  "labelEnabled": false
                }
              }
            }
          }
        },
        {
          "tile_id": "kpi-fill-rate",
          "type": "chart",
          "title": "Rose Bowl fill rate",
          "datasources": [
            "ds-kpis"
          ],
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "ATTENDANCE_PCT",
                  "labelField": "",
                  "format": "percent",
                  "decimals": 1,
                  "abbreviate": false,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": false,
                  "sparklineEnabled": false,
                  "labelEnabled": false
                }
              }
            }
          }
        },
        {
          "tile_id": "kpi-donations",
          "type": "chart",
          "title": "Donations after games",
          "datasources": [
            "ds-kpis"
          ],
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "DONATIONS_AFTER_GAME",
                  "labelField": "",
                  "format": "currency",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": false,
                  "sparklineEnabled": false,
                  "labelEnabled": false
                }
              }
            }
          }
        },
        {
          "tile_id": "revenue-by-game",
          "type": "chart",
          "title": "Revenue by home game",
          "datasources": [
            "ds-games"
          ],
          "spec": {
            "mark": {
              "type": "bar",
              "cornerRadiusEnd": 4
            },
            "encoding": {
              "x": {
                "field": "GAME_LABEL",
                "type": "nominal",
                "sort": {
                  "field": "HOME_WEEK",
                  "order": "ascending"
                },
                "title": null
              },
              "y": {
                "field": "TOTAL_REVENUE",
                "type": "quantitative",
                "title": "Revenue"
              },
              "tooltip": [
                {
                  "field": "GAME_LABEL",
                  "type": "nominal"
                },
                {
                  "field": "TOTAL_REVENUE",
                  "type": "quantitative",
                  "format": "$,.0f"
                }
              ]
            }
          }
        },
        {
          "tile_id": "game-scorecard",
          "type": "table",
          "title": "Home game scorecard",
          "datasources": [
            "ds-games"
          ],
          "spec": {
            "columns": [
              {
                "field": "HOME_WEEK"
              },
              {
                "field": "HOME_OPPONENT"
              },
              {
                "field": "OPPONENT_STYLE"
              },
              {
                "field": "HOME_RESULT"
              },
              {
                "field": "TOTAL_REVENUE",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "PER_CAP_SPEND",
                "format": {
                  "number": {
                    "precision": 2,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "ATTENDANCE_PCT",
                "format": {
                  "number": {
                    "style": "percent",
                    "precision": 1
                  }
                }
              },
              {
                "field": "DONATIONS_AFTER_GAME",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "GAME_LABEL",
                "hidden": true
              }
            ],
            "sort": [
              {
                "field": "HOME_WEEK",
                "direction": "asc"
              }
            ]
          }
        }
      ]
    },
    {
      "tab_id": "fan",
      "title": "Fan Experience",
      "tiles": [
        {
          "tile_id": "fan-sentiment",
          "type": "chart",
          "title": "Fan sentiment by home game (AI_SENTIMENT, -1 to 1)",
          "datasources": [
            "ds-fan-weeks"
          ],
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "rule",
                  "strokeDash": [
                    4,
                    4
                  ],
                  "color": "#888"
                },
                "encoding": {
                  "y": {
                    "datum": 0
                  }
                }
              },
              {
                "mark": {
                  "type": "line",
                  "point": true,
                  "strokeWidth": 2
                },
                "encoding": {
                  "x": {
                    "field": "GAME_LABEL",
                    "type": "nominal",
                    "sort": {
                      "field": "HOME_WEEK",
                      "order": "ascending"
                    },
                    "title": null
                  },
                  "y": {
                    "field": "AVG_FAN_SENTIMENT",
                    "type": "quantitative",
                    "title": "Avg sentiment",
                    "scale": {
                      "domain": [
                        -0.5,
                        0.75
                      ]
                    }
                  },
                  "tooltip": [
                    {
                      "field": "GAME_LABEL",
                      "type": "nominal"
                    },
                    {
                      "field": "AVG_FAN_SENTIMENT",
                      "type": "quantitative",
                      "format": ".3f"
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "tile_id": "tickets-by-category",
          "type": "chart",
          "title": "Service tickets by category (AI_CLASSIFY)",
          "datasources": [
            "ds-fan-categories"
          ],
          "spec": {
            "mark": {
              "type": "bar",
              "cornerRadiusEnd": 4
            },
            "encoding": {
              "y": {
                "field": "COMPLAINT_CATEGORY",
                "type": "nominal",
                "sort": "-x",
                "title": null
              },
              "x": {
                "field": "COMPLAINT_COUNT",
                "type": "quantitative",
                "title": "Tickets"
              }
            }
          }
        }
      ]
    }
  ]
}